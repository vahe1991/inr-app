{
  "expo": {
    "name": "ՆՄԲԿ",
    "slug": "inr-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "inrapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "am.nmmc.inrapp",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "icon": "./assets/images/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/notification-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "am.nmmc.inrapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tabIcons/Favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/brand-img.png",
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": false,
          "imageWidth": 280,
          "ios": {
            "backgroundColor": "#ffffff",
            "image": "./assets/images/brand-img.png",
            "enableFullScreenImage_legacy": false,
            "resizeMode": "contain",
            "imageWidth": 280
          },
          "android": {
            "backgroundColor": "#ffffff",
            "image": "./assets/images/brand-img.png",
            "resizeMode": "contain",
            "imageWidth": 280
          },
          "dark": {
            "backgroundColor": "#ffffff",
            "image": "./assets/images/brand-img.png",
            "imageWidth": 280
          }
        }
      ],
      "expo-font",
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Թույլատրեք ֆոտոխցիկի օգտագործումը՝ վերլուծության թերթիկը սկանավորելու համար։",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Թույլատրեք միկրոֆոնի օգտագործումը՝ ձայնային նամակ ուղարկելու համար։",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#5d4081",
          "defaultChannel": "default",
          "mode": "production",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withAndroidMainPackage",
      "./plugins/withFullScreenSplash",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a78a5f3b-10c1-4e2d-bd0d-f917a678b843"
      }
    }
  }
}
