{
  "expo": {
    "name": "ՆՄԲԿ",
    "slug": "inr-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/android-adaptive-foreground.png",
    "scheme": "inrapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/ios-light.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "bundleIdentifier": "com.xgalstyan.inrapp",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "icon": "./assets/images/android-adaptive-foreground.png",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/android-adaptive-foreground.png",
        "monochromeImage": "./assets/images/android-adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xgalstyan.inrapp",
      "googleServicesFile": "./google-services.json"
    },
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tabIcons/Favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "enableFullScreenImage_legacy": true,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-logo.png"
          }
        }
      ],
      "expo-font",
      [
        "expo-mlkit-ocr",
        {
          "iosEngine": "auto"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Թույլատրեք ֆոտոխցիկի օգտագործումը՝ վերլուծության թերթիկը սկանավորելու համար։",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Թույլատրեք միկրոֆոնի օգտագործումը՝ ձայնային նամակ ուղարկելու համար։",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5d4081",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withAndroidMainPackage",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a78a5f3b-10c1-4e2d-bd0d-f917a678b843"
      }
    }
  }
}
